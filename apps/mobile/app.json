{
  "expo": {
    "name": "PickAndSync",
    "slug": "packandsync",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "packandsync",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0052ad"
    },
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.packandsync.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#007bff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
