{
  "name": "packandsync",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "author": "Techzolo",
  "workspaces": [
    "frontend",
    "backend",
    "apps/mobile",
    "desktop",
    "apps/host-mobile"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "dev:desktop": "npm run dev --workspace=desktop",
    "build": "npm run build:backend && npm run build:frontend",
    "build:frontend": "npm run build --workspace=frontend",
    "pages:fallbacks": "node scripts/write-spa-fallbacks.mjs frontend/dist",
    "build:backend": "npx prisma@5.22.0 generate --schema=backend/prisma/schema.prisma",
    "build:mobile:web": "npm run build:web --workspace=apps/mobile",
    "build:android:apk": "npm run build:android:apk --workspace=apps/mobile",
    "build:desktop:exe": "npm run build:frontend && npm run build --workspace=desktop",
    "install:all": "npm install",
    "test": "vitest run",
    "lint": "npm run lint --workspace=frontend",
    "postinstall": "npm run build:backend",
    "dev:host": "npm run start --workspace=apps/host-mobile",
    "build:host:web": "npm run build:web --workspace=apps/host-mobile",
    "build:host:apk": "npm run build:android:apk --workspace=apps/host-mobile",
    "test:host": "npm test --workspace=apps/host-mobile"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "prisma": "5.22.0"
  },
  "devDependencies": {
    "@expo/config-plugins": "8.0.11",
    "concurrently": "^8.2.2"
  },
  "overrides": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5"
  }
}
