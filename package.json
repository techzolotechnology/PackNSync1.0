{
  "name": "packandsync",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "author": "Techzolo",
  "workspaces": [
    "frontend",
    "backend",
    "apps/mobile",
    "desktop"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "dev:desktop": "npm run dev --workspace=desktop",
    "build": "npm run build:backend && npm run build:frontend",
    "build:frontend": "npm run build --workspace=frontend",
    "pages:fallbacks": "node scripts/write-spa-fallbacks.mjs frontend/dist",
    "build:backend": "npx prisma@5.22.0 generate --schema=backend/prisma/schema.prisma",
    "build:mobile:web": "npm run build:web --workspace=apps/mobile",
    "build:android:apk": "npm run build:android:apk --workspace=apps/mobile",
    "build:desktop:exe": "npm run build:frontend && npm run build --workspace=desktop",
    "install:all": "npm install",
    "test": "vitest run",
    "lint": "npm run lint --workspace=frontend",
    "postinstall": "npm run build:backend"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "prisma": "5.22.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
