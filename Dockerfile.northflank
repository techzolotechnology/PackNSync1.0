# PickAndSync API Dockerfile for Northflank.
# Build context: repository root. Dockerfile path: /Dockerfile.northflank.
FROM node:20-bookworm-slim

WORKDIR /app

# OpenSSL is required by Prisma query engines.
RUN apt-get update -y \
    && apt-get install -y openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
COPY backend/package.json ./backend/
COPY frontend/package.json ./frontend/
COPY apps/mobile/package.json ./apps/mobile/
COPY desktop/package.json ./desktop/

COPY backend/prisma ./backend/prisma

RUN npm ci --workspace=backend --include-workspace-root --omit=dev --ignore-scripts

COPY backend ./backend

WORKDIR /app/backend

# Prisma generate validates datasource env names, but does not need a live DB.
# Runtime DATABASE_URL/DIRECT_URL values from Northflank override these placeholders.
ENV DATABASE_URL=""
ENV DIRECT_URL=""
RUN npx prisma generate

ENV NODE_ENV=production
EXPOSE 3001

CMD ["sh", "-c", "npx prisma migrate deploy && { node prisma/seedShowcase.js || echo 'showcase seed skipped'; } && node src/index.js"]
