  audience   String   // ALL | HOSTS | ORGANIZERS | VERIFIED | CITY
  city       String?
  recipients Int      @default(0)
  createdAt  DateTime @default(now())

  admin User? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@map("broadcasts")
}

model TripChatRead {
