/// In-app PickAndSync wallet (INR). Top up via Cashfree; spend in-app; withdraw outside.
model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  balance   Float    @default(0)
  /// Promotional credit (e.g. referral rewards): spendable on bookings, never withdrawable
  promoBalance Float @default(0)
  currency  String   @default("INR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

enum WalletTxType {
  TOPUP
  SPEND
  REFUND
  WITHDRAW
  ADJUST
  EARNING
  /// Promo credit removed because it reached its expiry date unused
  EXPIRE
}

enum WalletTxStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

model WalletTransaction {
  id              String         @id @default(uuid())
  walletId        String
  type            WalletTxType
  status          WalletTxStatus @default(PENDING)
  amount          Float
  balanceAfter    Float?
  description     String?
  /// Cashfree order id / payout id / rental booking id
  referenceId     String?
  provider        String?        // CASHFREE | INTERNAL
  metadata        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([referenceId])
  @@map("wallet_transactions")
}

model Vehicle {
  id              String   @id @default(uuid())
  ownerId         String
  make            String
  model           String
  year            Int
  /// App convention: CAR | BIKE | SCOOTER
  type            String   @default("CAR")
  licensePlate    String   @unique
  seats           Int
  fuelType        String
  transmission    String
  images          String[]
  rcUrl           String?
  isVerified      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner           User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  listings        RentalListing[]

  @@map("vehicles")
}

model RentalListing {
  id              String   @id @default(uuid())
  vehicleId       String
  hostId          String
  pricePerDay     Float
  /// ISO 3166-1 alpha-2; markets are gated by RENTAL_COUNTRIES
  country         String   @default("IN")
  /// ISO 4217, derived from country
  currency        String   @default("INR")
  location        String
  description     String?
  availableFrom   DateTime
  availableTo     DateTime
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vehicle         Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  host            User            @relation(fields: [hostId], references: [id], onDelete: Cascade)
  bookings        RentalBooking[]

  @@index([country, isActive])
  @@map("rental_listings")
}

model RentalBooking {
  id              String   @id @default(uuid())
  listingId       String
  renterId        String
  startDate       DateTime
  endDate         DateTime
  /// What the renter pays: hostAmount + platformFee
  totalPrice      Float
  /// Host's price for the dates (null on bookings made before commission)
  hostAmount      Float?
  /// PickAndSync commission added on top of the host's price
  platformFee     Float    @default(0)
  /// Offer discount taken off at payment; PickAndSync bears it, the host is paid in full
  discountAmount  Float    @default(0)
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  listing         RentalListing @relation(fields: [listingId], references: [id])
  renter          User          @relation("Renter", fields: [renterId], references: [id])
  driverReview    DriverReview?
  hostEarning     HostEarning?
  reports         Report[]
  offerRedemption OfferRedemption?

  @@map("rental_bookings")
}

/// Renter rates the car host / driver after a paid rental booking.
model DriverReview {
  id              String   @id @default(uuid())
  reviewerId      String
  driverId        String
  rentalBookingId String   @unique
  rating          Int
  comment         String?
  createdAt       DateTime @default(now())

  reviewer      User          @relation("DriverReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  driver        User          @relation("DriverReviewee", fields: [driverId], references: [id], onDelete: Cascade)
  rentalBooking RentalBooking @relation(fields: [rentalBookingId], references: [id], onDelete: Cascade)

  @@index([driverId, createdAt])
  @@map("driver_reviews")
}

model RideBooking {
