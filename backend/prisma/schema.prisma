}

model PolicyAcceptance {
  id              String   @id @default(uuid())
  userId          String
  policyType      String
  policyVersion   String
  acceptedAt      DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

