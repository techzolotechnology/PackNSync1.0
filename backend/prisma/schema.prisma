// This file is auto-generated by Prisma.
// datasource and generator config

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────
//  ENUMS
// ─────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum TripStatus {
  DRAFT
  OPEN
  FULL
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MemberStatus {
  PENDING
  APPROVED
  REJECTED
  LEFT
}

enum ExpenseCategory {
  ACCOMMODATION
  TRANSPORT
  FOOD
  ACTIVITY
  SHOPPING
  OTHER
}

enum NotificationType {
  TRIP_UPDATE
  JOIN_REQUEST
  REQUEST_APPROVED
  REQUEST_REJECTED
  EXPENSE_ADDED
  CHAT_MESSAGE
  PAYMENT_RECEIVED
  SYSTEM
}

// ─────────────────────────────────────────
//  MODELS
// ─────────────────────────────────────────

model User {
  id                String    @id @default(uuid())
  email             String?   @unique
  phoneNumber       String?   @unique
  name              String
  /// SHA-256 hash of the current OTP (never the plain code)
  otpCode           String?
  otpExpiresAt      DateTime?
  otpAttempts       Int       @default(0)
  avatarUrl         String?
  bio               String?
  city              String?
  languages         String[]  @default([])
  interests         String[]  @default([])
  emergencyContact  String?
  drivingYears      Int?
  travelStyle       String?
  role              Role      @default(USER)
  /// Shareable code for the referral programme (generated on first use)
  referralCode      String?   @unique
  referredById      String?
  /// Admin two-factor auth (Google Authenticator / any TOTP app)
  totpSecret        String?
  totpEnabled       Boolean   @default(false)
  /// SHA-256 hashes of one-time backup codes
  totpBackupCodes   String[]  @default([])
  /// Last TOTP time-step accepted, so a code cannot be replayed
  totpLastStep      Int?
  isBanned          Boolean   @default(false)
  banReason         String?
  refreshToken      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  organizedTrips   Trip[]         @relation("Organizer")
  memberships      TripMember[]
  messages         Message[]
  expensesPaid     Expense[]      @relation("Payer")
  expenseShares    ExpenseShare[]
  pollVotes        PollVote[]
  notifications    Notification[]
  announcements    Announcement[]
  payments         Payment[]
  vehicles         Vehicle[]
  rentalBookings   RentalBooking[] @relation("Renter")
  rentalListings   RentalListing[]
  rideBookings     RideBooking[]
  verifications    Verification[]
  policyAcceptances PolicyAcceptance[]
  linkedAccounts   LinkedAccount[]
  tripChatReads    TripChatRead[]
  explorePlans     ExplorePlan[]
  driverReviewsGiven    DriverReview[] @relation("DriverReviewer")
  driverReviewsReceived DriverReview[] @relation("DriverReviewee")
  wallet                Wallet?
  referredBy            User?          @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals             User[]         @relation("Referrals")
  adminActions          AdminAuditLog[]
  hostEarnings          HostEarning[]
  reportsFiled          Report[]        @relation("ReportReporter")
  reportsAssigned       Report[]        @relation("ReportAssignee")
  reportMessages        ReportMessage[]
  broadcasts            Broadcast[]
  promoGrants           PromoGrant[]      @relation("PromoGrantUser")
  promoGrantsGiven      PromoGrant[]      @relation("PromoGrantAdmin")
  offersCreated         Offer[]
  offerTargets          OfferRecipient[]
  offerRedemptions      OfferRedemption[]

  @@map("users")
}

model Trip {
  id              String      @id @default(uuid())
  title           String
  description     String?
  destination     String
  coverImageUrl   String?
  startDate       DateTime
  endDate         DateTime
  maxParticipants Int         @default(10)
  budgetEstimate  Float?
  status          TripStatus  @default(DRAFT)
  isPublic        Boolean     @default(true)
  organizerId     String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  organizer        User           @relation("Organizer", fields: [organizerId], references: [id], onDelete: Cascade)
  members          TripMember[]
  itineraryItems   ItineraryItem[]
  expenses         Expense[]
  messages         Message[]
  polls            Poll[]
  announcements    Announcement[]
  payments         Payment[]
  chatReads        TripChatRead[]
  invite           TripInvite?

  @@map("trips")
}

/// Private invite link for a trip. Kept out of the Trip row so trip queries
/// can never leak the code to non-organizers.
model TripInvite {
  id        String   @id @default(uuid())
  tripId    String   @unique
  code      String   @unique
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("trip_invites")
}

/// Who did what in the admin panel. Rows are kept when the admin account is deleted.
model AdminAuditLog {
  id         String   @id @default(uuid())
  adminId    String?
  action     String   // e.g. USER_BAN, PAYMENT_REFUND, WITHDRAWAL_COMPLETE
  targetType String   // USER | TRIP | BOOKING | PAYMENT | WITHDRAWAL | VERIFICATION | VEHICLE | LISTING
  targetId   String?
  summary    String
  metadata   Json?
  createdAt  DateTime @default(now())

  admin User? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}

/// Money owed to a host for a paid booking. Released to the host's wallet
/// (withdrawable) once releaseAt passes, unless the booking is refunded.
model HostEarning {
  id          String    @id @default(uuid())
  bookingId   String    @unique
  hostId      String
  amount      Float
  platformFee Float     @default(0)
  status      String    @default("PENDING") // PENDING | RELEASED | CANCELLED
  releaseAt   DateTime
  releasedAt  DateTime?
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  booking RentalBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  host    User          @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@index([status, releaseAt])
  @@index([hostId, status])
  @@map("host_earnings")
}

/// A customer report or dispute (safety, fraud, damage, payment …).
model Report {
  id              String    @id @default(uuid())
  reporterId      String
  category        String    // SAFETY | HARASSMENT | FRAUD | VEHICLE_DAMAGE | PAYMENT | LISTING_INACCURATE | OTHER
  priority        String    @default("NORMAL") // HIGH | NORMAL
  targetType      String    @default("OTHER") // USER | LISTING | TRIP | BOOKING | OTHER
  targetId        String?
  bookingId       String?
  subject         String
  description     String
  evidence        String[]  @default([])
  status          String    @default("OPEN") // OPEN | IN_REVIEW | RESOLVED | DISMISSED
  resolution      String?
  assignedAdminId String?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  reporter      User            @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  assignedAdmin User?           @relation("ReportAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  booking       RentalBooking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  messages      ReportMessage[]

  @@index([status, priority, createdAt])
  @@index([reporterId, createdAt])
  @@map("reports")
}

model ReportMessage {
  id        String   @id @default(uuid())
  reportId  String
  authorId  String?
  fromAdmin Boolean  @default(false)
  body      String
  createdAt DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  author User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([reportId, createdAt])
  @@map("report_messages")
}

