enum ExplorePlanStatus {
  DRAFT
  SAVED
}

model ExplorePlan {
  id            String            @id @default(uuid())
  userId        String
  title         String
  destination   String
  startDate     DateTime
  endDate       DateTime
  pace          String            // relaxed | balanced | packed
  budget        String            // budget | mid | luxury
  travelerType  String            // solo | couple | family | friends | work | backpacker
  interests     String[]          @default([])
  notes         String?
  summary       String?
  status        ExplorePlanStatus @default(DRAFT)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  days ExplorePlanDay[]

  @@index([userId, updatedAt])
  @@map("explore_plans")
}

model ExplorePlanDay {
  id        String @id @default(uuid())
  planId    String
  dayNumber Int
  title     String
  theme     String?
  summary   String?

  plan  ExplorePlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  stops ExplorePlanStop[]

  @@unique([planId, dayNumber])
  @@map("explore_plan_days")
}

model ExplorePlanStop {
  id        String  @id @default(uuid())
  dayId     String
  sortOrder Int     @default(0)
  name      String
  address   String?
  lat       Float?
  lng       Float?
  startTime String?
  endTime   String?
  category  String?
  reason    String?
  energy    String? // low | medium | high
  notes     String?

  day ExplorePlanDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([dayId, sortOrder])
  @@map("explore_plan_stops")
}
