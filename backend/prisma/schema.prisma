}

model LinkedAccount {
  id              String   @id @default(uuid())
  userId          String
  provider        String   // UBER, OLA, RAPIDO
  accessToken     String?
  refreshToken    String?
  expiresAt       DateTime?
  isConnected     Boolean  @default(true)
  createdAt       DateTime @default(now())
