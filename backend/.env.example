DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/triptogether"
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_here_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Redis
REDIS_URL=redis://localhost:6379

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Cashfree Payment Gateway (wallet top-up)
# Dashboard: https://merchant.cashfree.com/ → Developers → API Keys
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox
# CASHFREE_API_VERSION=2023-08-01
# Force mock top-ups/withdrawals without Cashfree (dev only)
# CASHFREE_MOCK=true
# Public API URL for Cashfree webhooks (production)
API_PUBLIC_URL=https://packandsync-api.onrender.com

# Cashfree Payouts (wallet → bank/UPI outside the app)
# Separate product keys from PG — enable Payouts in Cashfree dashboard
CASHFREE_PAYOUT_CLIENT_ID=
CASHFREE_PAYOUT_CLIENT_SECRET=
CASHFREE_PAYOUT_CONTACT_EMAIL=support@pickandsync.com
CASHFREE_PAYOUT_CONTACT_PHONE=9999999999

# ZeptoMail SMTP (email OTP + booking mail)
# Dashboard: Agents → pickandsync → SMTP / API → SMTP
SMTP_HOST=smtp.zeptomail.in
SMTP_PORT=465
SMTP_USER=emailapikey
SMTP_PASS=your_zeptomail_smtp_token
EMAIL_FROM=PickAndSync <noreply@pickandsync.com>
# Force console OTP for all contacts (useful for local demos)
# OTP_CONSOLE_FALLBACK=true

# MSG91 (SMS OTP — optional, needs DLT in India)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_msg91_otp_template_id

# Twilio (SMS OTP — good for trial/testing; verify your phone in Twilio console)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Frontend URLs (for CORS and email links)
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173

# All clients default to the common deployed API:
# https://packandsync-api.onrender.com/api
# For deliberate local testing, override the client environment variable with
# http://127.0.0.1:3001/api (web/desktop) or your PC LAN IP (physical mobile).

# Ride provider integrations
# Uber requires an approved developer app and privileged ride-request scopes.
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
UBER_REDIRECT_URI=http://localhost:3001/api/rides/auth/uber/callback

# Ola requires an Ola Developer/partner token. Booking and upfront user fares require partner approval.
OLA_APP_TOKEN=

# Rapido and Zoomcar require official partner API access. Do not collect consumer app passwords.
RAPIDO_PARTNER_API_KEY=
ZOOMCAR_PARTNER_API_KEY=

# Explore (Ask the map) — OpenAI + Google Places
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Google Places (enable Places API on the same Cloud project as Maps)
# Can reuse your Maps key if Places API is enabled for it:
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=
# Where Explore looks by default when the query names no city and the user
# has not shared location. Without this, Google returns US-centric results.
EXPLORE_REGION=in
EXPLORE_COUNTRY=India
# Optional home-city bias, "lat,lng" (e.g. 12.9716,77.5946 for Bengaluru)
EXPLORE_DEFAULT_CENTER=
EXPLORE_DEFAULT_CENTER_LABEL=
