# Required on Northflank
NODE_ENV=production
PORT=3001

# Neon Postgres
# Runtime should use the pooled URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
# Prisma migrations should use the direct URL.
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SAMESITE=none

# Public URLs
FRONTEND_URL=https://pickandsync.com
FRONTEND_URLS=https://pickandsync.com,https://www.pickandsync.com,https://techzolotechnology.github.io
API_PUBLIC_URL=https://YOUR-NORTHFLANK-SERVICE-CODE.northflank.app

# OTP delivery
# Testing only. OTPs will appear in Northflank logs.
# For real users, configure SMTP/SMS and remove this.
OTP_CONSOLE_FALLBACK=true
SMTP_HOST=smtp.zeptomail.in
SMTP_PORT=465
SMTP_USER=emailapikey
SMTP_PASS=
EMAIL_FROM=PickAndSync <noreply@pickandsync.com>

# Optional integrations
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=
EXPLORE_REGION=in
EXPLORE_COUNTRY=India
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox
CASHFREE_PAYOUT_CLIENT_ID=
CASHFREE_PAYOUT_CLIENT_SECRET=
CASHFREE_PAYOUT_CONTACT_EMAIL=support@pickandsync.com
CASHFREE_PAYOUT_CONTACT_PHONE=9999999999
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
