# Set by `npm run hero:upload` in backend (or copy from Cloudinary dashboard)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_HERO_VIDEO_ID=packandsync/hero-bg

# Web and packaged desktop use this same backend.
# Change these only when deliberately testing a local or staging API.
VITE_API_URL=https://packandsync-api.onrender.com/api
VITE_SOCKET_URL=https://packandsync-api.onrender.com
# Optional Vite proxy override for deliberate local-backend development.
# VITE_DEV_BACKEND_ORIGIN=http://127.0.0.1:3001
# Google Maps JavaScript API (Explore map, rentals map, autocomplete)
# Enable: Maps JavaScript API + Places API + Geocoding API
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_key
