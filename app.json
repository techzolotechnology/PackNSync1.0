{
  "expo": {
    "ios": {},
    "web": {
      "output": "single",
      "bundler": "metro"
    },
    "icon": "./assets/icon.png",
    "name": "PickAndSync",
    "slug": "packandsync",
    "extra": {
      "eas": {
        "projectId": "1c33f722-bd62-4a95-8e81-a23d3c1d5b67"
      },
      "mapsConfigured": false
    },
    "owner": "kartikgauttam",
    "scheme": "packandsync",
    "android": {
      "package": "com.packandsync.app",
      "versionCode": 10,
      "adaptiveIcon": {
        "backgroundColor": "#007bff",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0052ad"
        }
      ],
      [
        "expo-secure-store"
      ],
      [
        "expo-asset"
      ],
      [
        "expo-font"
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Take vehicle photos for your booking inspection.",
          "photosPermission": "Choose vehicle photos for your booking inspection.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#007bff"
        }
      ],
      "expo-status-bar"
    ],
    "updates": {
      "url": "https://u.expo.dev/1c33f722-bd62-4a95-8e81-a23d3c1d5b67"
    },
    "version": "1.0.8",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "sdkVersion": "58.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ]
  }
}
